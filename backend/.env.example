# ---- App ----
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-long-random-string

# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/resume_analyser

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- LLM ----
LLM_PROVIDER=openai          # openai | bedrock | local
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=local     # local | openai | bedrock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI
OPENAI_API_KEY=

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- S3 ----
S3_BUCKET=ai-resume-analyser-dev
S3_REGION=us-east-1

# ---- Observability ----
PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
