# Terraform working directories
.terraform/
.terraform.lock.hcl

# State files — NEVER commit state to source control
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files containing secrets or environment-specific values
# *.tfvars.example files ARE committed — they serve as documentation
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Sensitive output files
*.tfplan
*.tfplan.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# .terraform.d — provider cache, plugins
.terraform.d/

# Generated provider lock files (commit these in team setups)
# .terraform.lock.hcl

# macOS
.DS_Store

# JetBrains IDEs
.idea/

# VS Code
.vscode/

# Environment files
.env
.env.*
