###############################################################################
# envs/dev/terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit secrets or account IDs.
###############################################################################

aws_region = "us-east-1"

vpc_cidr = "10.0.0.0/16"

# Restrict to your VPN/office IP in practice
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.medium"]
node_min_size       = 1
node_max_size       = 3
node_desired_size   = 2

rds_instance_class = "db.t4g.micro"

redis_node_type = "cache.t4g.micro"

# Must be unique globally — use your AWS account ID or a random string
resume_bucket_suffix = "123456789012"
