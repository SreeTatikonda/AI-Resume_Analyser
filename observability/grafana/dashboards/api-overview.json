    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "right" }, "pieType": "donut", "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(llm_tokens_total[24h])) by (provider)",
          "legendFormat": "{{ provider }}",
          "refId": "A",
