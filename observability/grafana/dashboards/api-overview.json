          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(analysis_duration_seconds_bucket[5m])) by (le, llm_provider))",
          "legendFormat": "p95 — {{ llm_provider }}",
          "refId": "B"
        }
      ],
      "title": "Analysis Duration — p50 / p95 by Provider",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 8, "lineWidth": 2 },
