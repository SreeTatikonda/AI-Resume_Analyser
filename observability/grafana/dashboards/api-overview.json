          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(llm_tokens_total{kind=\"completion\"}[5m])) by (provider, model)",
          "legendFormat": "completion — {{ provider }}/{{ model }}",
          "refId": "B"
        }
